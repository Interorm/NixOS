diff --git a/trellis2/modules/sparse/attention/sdpa_varlen.py b/trellis2/modules/sparse/attention/sdpa_varlen.py
new file mode 100644
index 0000000..7398384
--- /dev/null
+++ b/trellis2/modules/sparse/attention/sdpa_varlen.py
@@ -0,0 +1,57 @@
+"""
+Variable-length attention on top of torch.nn.functional.scaled_dot_product_attention.
+
+Stand-in for the xformers / flash-attn varlen kernels on GPUs that have neither
+(e.g. Pascal, sm_61).  PyTorch's memory-efficient SDPA kernel runs on sm_50+.
+
+Inputs are packed token tensors as used by the sparse attention modules:
+    q: [T_q, H, C]   k: [T_kv, H, C]   v: [T_kv, H, C_v]
+with per-sequence lengths q_seqlen / kv_seqlen (lists or 1-D tensors).
+"""
+from typing import *
+import torch
+import torch.nn.functional as F
+
+__all__ = ['sdpa_varlen']
+
+
+def _as_list(lens) -> List[int]:
+    if isinstance(lens, torch.Tensor):
+        return [int(x) for x in lens.tolist()]
+    return [int(x) for x in lens]
+
+
+def _pad(x: torch.Tensor, lens: List[int]) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Packed [T, H, C] -> padded [B, L, H, C] plus the (batch, position) index of every token."""
+    B, L = len(lens), max(lens)
+    lens_t = torch.tensor(lens, device=x.device)
+    batch_idx = torch.repeat_interleave(torch.arange(B, device=x.device), lens_t)
+    starts = torch.cumsum(lens_t, 0) - lens_t
+    pos_idx = torch.arange(x.shape[0], device=x.device) - starts[batch_idx]
+    out = x.new_zeros((B, L, *x.shape[1:]))
+    out[batch_idx, pos_idx] = x
+    return out, batch_idx, pos_idx
+
+
+def sdpa_varlen(q: torch.Tensor, k: torch.Tensor, v: torch.Tensor, q_seqlen, kv_seqlen) -> torch.Tensor:
+    q_seqlen, kv_seqlen = _as_list(q_seqlen), _as_list(kv_seqlen)
+    assert len(q_seqlen) == len(kv_seqlen), "q and kv must have the same number of sequences"
+
+    if len(q_seqlen) == 1:
+        # Single sequence: plain dense attention, no mask -> memory-efficient kernel.
+        out = F.scaled_dot_product_attention(
+            q.unsqueeze(0).transpose(1, 2), k.unsqueeze(0).transpose(1, 2), v.unsqueeze(0).transpose(1, 2)
+        )
+        return out.transpose(1, 2)[0]
+
+    qp, qb, qi = _pad(q, q_seqlen)
+    kp, _, _ = _pad(k, kv_seqlen)
+    vp, _, _ = _pad(v, kv_seqlen)
+    kv_len = torch.tensor(kv_seqlen, device=q.device)
+    # [B, 1, 1, L_kv]: True = attend.  Padded *query* rows still see their real keys,
+    # so no row is fully masked (which would produce NaNs); they are dropped below.
+    mask = (torch.arange(kp.shape[1], device=q.device)[None, :] < kv_len[:, None])[:, None, None, :]
+    out = F.scaled_dot_product_attention(
+        qp.transpose(1, 2), kp.transpose(1, 2), vp.transpose(1, 2), attn_mask=mask
+    ).transpose(1, 2)                                   # [B, L_q, H, C_v]
+    return out[qb, qi]
